# Choose: demo, openai, gemini, or ollama
EVALFORGE_PROVIDER=demo

# OpenAI-compatible provider (OpenAI, OpenRouter, local vLLM, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=
EVALFORGE_MODEL=gpt-4o-mini

# Gemini provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama (OpenAI-compatible endpoint)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Judge configuration. "same" uses the target provider/model.
JUDGE_PROVIDER=same
JUDGE_MODEL=

# Evaluation behavior
EVALFORGE_MAX_WORKERS=3
EVALFORGE_REQUEST_TIMEOUT=60
EVALFORGE_DEFAULT_PASS_THRESHOLD=3.5
EVALFORGE_REGRESSION_TOLERANCE=0.25
